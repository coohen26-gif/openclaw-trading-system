{
  "version": "1.0.0",
  "description": "Seuils des Gates Bailey pour Saiyan v0.3",
  
  "dsr": {
    "min_dsr": 0.0,
    "max_pvalue": 0.05,
    "default_n_trials": 1,
    "description": "Deflated Sharpe Ratio doit être > 0 avec p-value < 0.05"
  },
  
  "psr": {
    "min_psr": 0.95,
    "default_sr_benchmark": 0.0,
    "aggressive_sr_benchmark": 0.5,
    "description": "Probability SR > benchmark doit être ≥ 95%"
  },
  
  "pbo": {
    "max_pbo_estimate": 0.10,
    "max_pbo_gumbel": 0.10,
    "description": "Probability Backtest Overfitting doit être < 10%"
  },
  
  "wilson": {
    "min_wr_lower": 0.50,
    "target_wr_lower": 0.70,
    "confidence_level": 0.95,
    "min_n_trades": 30,
    "description": "Borne inf Wilson WR doit être > 50% (target 70%)"
  },
  
  "cpcv": {
    "n_splits": 5,
    "embargo_pct": 0.05,
    "min_mean_score": 0.0,
    "description": "Mean CPCV score doit être > 0"
  },
  
  "global": {
    "all_gates_must_pass": true,
    "allow_skip_if_missing_data": true,
    "log_level": "INFO"
  }
}
